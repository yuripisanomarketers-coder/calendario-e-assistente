# URL pubblico dell'app (in locale: http://localhost:3000)
APP_URL=http://localhost:3000

# L'unica email Google che può accedere
ALLOWED_EMAIL=tuaemail@gmail.com

# Stringa casuale lunga per cifrare la sessione (es. `openssl rand -base64 32`)
SESSION_SECRET=

# Credenziali OAuth Google (Google Cloud Console → API e servizi → Credenziali)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chiave API Anthropic per l'assistente (console.anthropic.com)
ANTHROPIC_API_KEY=

# Token utente Slack (xoxp-...), facoltativo
SLACK_USER_TOKEN=

# Fuso orario
TIME_ZONE=Europe/Rome
